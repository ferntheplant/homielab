# Read by stacks/manage.sh and scripts/snapshot-data.sh. Not secret.
DATA_PATH=/home/fjorn/homielab/data
# This server (micro-homie) on the tailnet
TS_HOST=micro-homie.tail8cc0d3.ts.net
TS_IP=100.80.5.26
# The tailnet's DNS name. Each Tailscale Service is <name>.$TS_TAILNET (tailscale/services.json)
TS_TAILNET=tail8cc0d3.ts.net
# The Mac that keeps llama-server, the iMessage bridge, and the agent status monitor
LIL_HOMIE_HOST=lil-homie.tail8cc0d3.ts.net
# llama-server on lil-homie (Tailscale Serve TCP forwards, see hosts/lil-homie/llm/README.md):
# chat on 8080, embeddings through the truncating proxy on 8081
LLM_URL=http://lil-homie:8080
LLM_EMBED_URL=http://lil-homie:8081
# Forgejo sign-in (stacks/forgejo/Caddyfile): this Tailscale login signs in as this Forgejo user
TS_LOGIN=ferntheplant@github
FORGEJO_USER=ferntheplant
# The docker group on this box (stat -c %g /var/run/docker.sock), for the Forgejo runner
DOCKER_GID=988
