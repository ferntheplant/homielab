# Read by stacks/manage.sh and scripts/snapshot-data.sh. Not secret.
DATA_PATH=/home/fjorn/lil-homie/data
# This server (micro-homie) on the tailnet
TS_HOST=micro-homie.tail8cc0d3.ts.net
TS_IP=100.80.5.26
# The Mac that keeps Ollama, the iMessage bridge, and the agent status monitor
LIL_HOMIE_HOST=lil-homie.tail8cc0d3.ts.net
# Ollama on lil-homie (Tailscale Serve TCP forward). Use the short name: Ollama answers 403 to a
# Host header it does not know, and it rejects the full ts.net name.
OLLAMA_URL=http://lil-homie:11434
