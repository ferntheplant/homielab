<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.fjorn.llm-embed-proxy</string>
  <!-- Cuts /v1/embeddings input to 512 tokens like Ollama did, then forwards to llama-server.
       Karakeep reaches it through Tailscale Serve (tcp 8081). -->
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>/Users/fjorn/homielab/hosts/lil-homie/llm/embed_proxy.py</string>
    <string>--port</string><string>8081</string>
  </array>
  <key>StandardOutPath</key><string>/Users/fjorn/Library/Logs/llama-server/embed-proxy.log</string>
  <key>StandardErrorPath</key><string>/Users/fjorn/Library/Logs/llama-server/embed-proxy.log</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
</dict></plist>
