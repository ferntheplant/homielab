<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.fjorn.dev-proxy-caddy</string>
  <!-- Caddy for https://*.dev.fjorn.dev. Tailscale Serve forwards tailnet 443 to it (tcp 127.0.0.1:8443). -->
  <key>ProgramArguments</key><array>
    <string>/Users/fjorn/homielab/hosts/lil-homie/dev-proxy/caddy.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/fjorn/Library/Logs/dev-proxy/dev-proxy-caddy.log</string>
  <key>StandardErrorPath</key><string>/Users/fjorn/Library/Logs/dev-proxy/dev-proxy-caddy.log</string>
</dict></plist>
