<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- LaunchDaemon (root). Install with: sudo ~/homielab/scripts/install-tailscaled-daemon.sh -->
  <key>Label</key><string>dev.fjorn.tailscaled</string>
  <key>ProgramArguments</key><array>
    <string>/usr/local/libexec/lil-homie/tailscaled</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/var/log/tailscaled.log</string>
  <key>StandardErrorPath</key><string>/var/log/tailscaled.log</string>
</dict></plist>
