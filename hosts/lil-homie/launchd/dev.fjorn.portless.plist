<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.fjorn.portless</string>
  <!-- portless proxy for the dev proxy (127.0.0.1:1355). Caddy sends <name>.dev.fjorn.dev here as <name>.localhost. -->
  <key>ProgramArguments</key><array>
    <string>/Users/fjorn/homielab/hosts/lil-homie/dev-proxy/portless.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>/Users/fjorn/Library/Logs/dev-proxy/portless.log</string>
  <key>StandardErrorPath</key><string>/Users/fjorn/Library/Logs/dev-proxy/portless.log</string>
</dict></plist>
