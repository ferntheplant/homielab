# Forgejo for CI. The runner and its job containers reach Forgejo here, on forgejo_ci, and never
# through forgejo-proxy. This proxy sets no sign-in header: a job signs in with its token only.
#
# It removes any X-WEBAUTH-* header from the client, because Forgejo trusts X-WEBAUTH-USER from any
# sender (see Caddyfile). Job containers run untrusted code, so they must not reach forgejo:3000 or
# forgejo-proxy directly: they are on forgejo_ci only, and only this proxy joins both networks.
{
	admin off
	auto_https off
}

:80 {
	request_header -X-WEBAUTH-USER
	request_header -X-WEBAUTH-EMAIL
	request_header -X-WEBAUTH-FULLNAME
	reverse_proxy forgejo:3000
}
