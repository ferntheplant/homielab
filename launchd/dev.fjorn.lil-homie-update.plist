<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.fjorn.lil-homie-update</string>
  <key>ProgramArguments</key><array>
    <string>/Users/fjorn/lil-homie/stacks/manage.sh</string>
    <string>update</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/Users/fjorn/.orbstack/bin:/opt/nanobrew/prefix/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <!-- Weekly, Sunday 04:30 (after the nightly snapshot and backup) -->
  <key>StartCalendarInterval</key><dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/fjorn/Library/Logs/lil-homie/update.log</string>
  <key>StandardErrorPath</key><string>/Users/fjorn/Library/Logs/lil-homie/update.log</string>
</dict></plist>
