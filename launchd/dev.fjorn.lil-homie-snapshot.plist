<plist version="1.0"><dict>
  <key>Label</key><string>dev.fjorn.lil-homie-snapshot</string>
  <key>ProgramArguments</key><array>
    <string>/Users/fjorn/lil-homie/scripts/snapshot-data.sh</string>
  </array>
