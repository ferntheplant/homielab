  <key>StandardOutPath</key><string>/Users/fjorn/Library/Logs/lil-homie/snapshot.log</string>
  <key>StandardErrorPath</key><string>/Users/fjorn/Library/Logs/lil-homie/snapshot.log</string>
</dict></plist>
